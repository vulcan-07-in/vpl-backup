generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  shortName String
  color     String   @default("#FFFFFF")
  groupId   String   // e.g. "A" or "B"
  purse     Int      @default(10000)
  players   Player[]
  
  homeMatches Match[] @relation("Team1")
  awayMatches Match[] @relation("Team2")
  wonMatches  Match[] @relation("Winner")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id        String   @id @default(uuid())
  name      String
  role      String   // "Batsman", "Bowler", "All Rounder", "Wicketkeeper"
  price     Int      @default(0)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id            String    @id @default(uuid())
  matchNo       String    @unique // e.g., "M 1", "SF 1"
  stage         String    // "Group A", "Final"
  group         String?   // "A", "B", null for knockouts
  scheduledTime DateTime?
  status        String    @default("SCHEDULED") // SCHEDULED, LIVE, INNINGS_BREAK, COMPLETED, ABANDONED
  
  team1Id       String
  team2Id       String
  team1         Team      @relation("Team1", fields: [team1Id], references: [id])
  team2         Team      @relation("Team2", fields: [team2Id], references: [id])
  
  winnerId      String?
  winner        Team?     @relation("Winner", fields: [winnerId], references: [id])
  
  tossWinnerId  String?
  tossDecision  String?   // "BAT" or "BOWL"
  
  liveState     Json?     // Persistent snapshot of the live match state (innings, balls, etc.)
  isFunMatch    Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


// varchasva_accounts and vpl_registrations are managed via raw SQL (not Prisma).
// The app reads/writes them using @supabase/supabase-js directly.
// The @@ignore directive tells Prisma: "this table exists, don't touch it."

model varchasva_accounts {
  account_id    String   @id
  name          String
  mobile_number String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  @@ignore
}

model vpl_registrations {
  registration_id String   @id
  account_id      String
  season          Int      @default(2)
  team_name       String   @default("UNSOLD")
  role            String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())
  tier            String?
  is_captain      Boolean  @default(false)
  is_approved     Boolean  @default(true)
  price           Int      @default(0)
  gender          String   @default("Male")

  @@ignore
}

model vpl_auction_state {
  id                   Int      @id @default(1)
  status               String
  active_player_id     String?
  current_bid          Int      @default(0)
  leading_team_id      String?
  last_update          DateTime @default(now())
  show_pool_to_viewers Boolean  @default(true)
  active_pool          String?
  bid_increment        Int?
}

model vpl_auction_history {
  id         Int      @id @default(autoincrement())
  player_id  String
  team_id    String
  bid_amount Int
  timestamp  DateTime @default(now())
}
